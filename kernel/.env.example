# Truss kernel configuration — copy to .env and fill in real values.
# All variables use the TRUSS_ prefix.

# PostgreSQL connection (async driver)
TRUSS_DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/truss

# JWT signing secret — CHANGE THIS in production
TRUSS_JWT_SECRET=change-me-to-a-long-random-string

# Fernet key for encrypting AI keys at rest — generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TRUSS_AI_VAULT_SECRET=change-me-to-a-fernet-key

# Optional
# TRUSS_DEBUG=true
# TRUSS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# TRUSS_ACCESS_TOKEN_EXPIRE_MINUTES=1440
