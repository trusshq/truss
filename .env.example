# Truss self-host configuration - copy to .env and change the secrets!
#   cp .env.example .env

# --- REQUIRED: set strong random values in production ---
TRUSS_JWT_SECRET=REPLACE_ME_jwt_secret
TRUSS_AI_VAULT_SECRET=REPLACE_ME_vault_secret
POSTGRES_PASSWORD=REPLACE_ME_db_password

# --- optional overrides ---
POSTGRES_USER=truss
POSTGRES_DB=truss
POSTGRES_PORT=5432
KERNEL_PORT=8000
FRONTEND_PORT=3000
TRUSS_DEBUG=false
TRUSS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
